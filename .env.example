# Copy to .env and fill in what you have. Every key is optional:
# sources without credentials are skipped, and with no source configured the
# platform runs on synthetic demo data (DEMO_MODE=auto).

# auto | true | false
DEMO_MODE=auto

# --- Data sources ---
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=trend_intel_agent:v1.0 (by /u/yourusername)

# X/Twitter recent search needs a paid API tier (Basic or above).
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

YOUTUBE_API_KEY=your_youtube_api_key
# Google Trends needs no key.

# --- Content ideas (LLM) ---
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# --- Alerts ---
SLACK_WEBHOOK_URL=your_slack_webhook_url
DISCORD_WEBHOOK_URL=your_discord_webhook_url

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_app_password
FROM_EMAIL=your_from_address
ALERT_TO_EMAIL=your_alert_recipient

# --- Database & cache (docker-compose overrides these for containers) ---
DATABASE_URL=postgresql://trend_user:trend_password@localhost:5432/trend_db
REDIS_URL=redis://localhost:6379/0
